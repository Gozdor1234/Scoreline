<?xml version="1.0" encoding="utf-8"?>
<!-- App icon background: blue gradient, light at the top to deep blue at the bottom.
     Gradient spans the visible icon area (18..90 of the 108 dp canvas). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="18" android:endX="54" android:endY="90"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#FF03A6E7" />
                <item android:offset="1" android:color="#FF0A558E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
